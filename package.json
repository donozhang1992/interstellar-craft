{
  "name": "interstellar-craft",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && eslint . && prettier --check .",
    "test": "vitest run --coverage",
    "e2e": "playwright test",
    "ci": "npm run check && npm run test && npm run e2e"
  },
  "dependencies": {
    "three": "0.160.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/three": "^0.160.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.10.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
